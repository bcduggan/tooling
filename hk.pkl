amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

hooks {
    ["commit-msg"] {
        steps {
            ["check-conventional-commit"] {
                env {
                    ["TYPES"] = "build,ci,docs,feat,fix,format,perf,refactor,revert,test,tooling"  
                }
                check = "hk util check-conventional-commit --allowed-types $TYPES {{commit_msg_file}}"
            }
        }
    }
    ["pre-push"] {
        steps {
            ["verify-signatures"] {
                check = "mise run git:hooks:pre-push:verify-signatures {{hook_args}}"
                stdin = "{{hook_stdin}}"
            }
        }
    }
}
